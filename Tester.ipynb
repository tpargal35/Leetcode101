    "from heapq import *\n",
    "cheap = []          # ✅ step 1: create list\n",
    "heapify(cheap)      # ✅ step 2: heapify it (in-place, returns None)\n",
    "heappush(cheap, 1)  # ✅ step 3: push to cheap\n",
    "heappush(cheap, 5)\n",
    "heappush(cheap, 3)\n",
    "print(cheap)"
   ]
